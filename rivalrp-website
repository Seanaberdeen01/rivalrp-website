<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>RivalRP</title>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;700&display=swap" rel="stylesheet">
  <style>
    body {
      margin: 0;
      font-family: 'Inter', sans-serif;
      background: #121212;
      color: #fff;
      display: flex;
      flex-direction: column;
      align-items: center;
    }
    header {
      background: #1f1f1f;
      padding: 1rem 2rem;
      display: flex;
      flex-direction: column;
      align-items: center;
      width: 100%;
    }
    header h1 {
      color: #f44336;
      margin: 0;
      text-align: center;
    }
    nav {
      margin-top: 1rem;
    }
    nav a {
      color: #fff;
      margin: 0 1rem;
      text-decoration: none;
    }
    section {
      padding: 3rem 2rem;
      border-bottom: 1px solid #333;
      max-width: 800px;
      width: 100%;
      text-align: center;
    }
    h2 { color: #f44336; }
    .staff {
      display: flex;
      flex-wrap: wrap;
      gap: 2rem;
      justify-content: center;
    }
    .staff-member {
      background: #1f1f1f;
      padding: 1rem;
      border-radius: 10px;
      width: 200px;
      text-align: center;
    }
    form input, form textarea, form button {
      display: block;
      width: 100%;
      margin: 0.5rem 0;
      padding: 0.5rem;
      border: none;
      border-radius: 5px;
    }
    form button {
      background: #f44336;
      color: #fff;
      cursor: pointer;
    }
    iframe {
      border: none;
      width: 100%;
      height: 500px;
    }
  </style>
</head>
<body>
  <header>
    <h1>RivalRP</h1>
    <nav>
      <a href="#status">Status</a>
      <a href="#players">Players</a>
      <a href="#staff">Staff</a>
      <a href="#apply">Apply</a>
      <a href="#discord">Discord</a>
    </nav>
  </header>

  <section id="status">
    <h2>Server Status</h2>
    <p>Server is <strong style="color:lime;">Online</strong></p>
    <p>IP: <a href="https://cfx.re/join/e787ma" target="_blank" style="color: #4FC3F7; text-decoration: underline;">cfx.re/join/e787ma</a></p>
  </section>

  <section id="players">
    <h2>Live Player Count</h2>
    <p>Current Players Online: <span id="playerCount">Loading...</span></p>
    <script>
      async function fetchPlayerCount() {
        try {
          const response = await fetch('https://servers-frontend.fivem.net/api/servers/single/e787ma');
          const data = await response.json();
          const count = data?.Data?.clients ?? 'Unavailable';
          document.getElementById('playerCount').textContent = count;
        } catch (error) {
          document.getElementById('playerCount').textContent = 'Unavailable';
        }
      }
      fetchPlayerCount();
      setInterval(fetchPlayerCount, 30000); // Update every 30 seconds
    </script>
  </section>

  <section id="staff">
    <h2>Staff Roster</h2>
    <div class="staff">
      <div class="staff-member">
        <h3>Owner</h3>
        <p>Murphy<br>Spooky</p>
      </div>
      <div class="staff-member">
        <h3>Developer</h3>
        <p>Spooky<br>Murphy</p>
      </div>
    </div>
  </section>

  <section id="apply">
    <h2>Whitelist Application</h2>
    <form action="https://yourformbackend.com" method="POST">
      <input type="text" name="name" placeholder="Your Name" required />
      <input type="email" name="email" placeholder="Email" required />
      <textarea name="why" placeholder="Why do you want to join RivalRP?" rows="5" required></textarea>
      <button type="submit">Submit Application</button>
    </form>
  </section>

  <section id="discord">
    <h2>Join Our Discord</h2>
    <img src="https://i.imgur.com/OElEbg6.png" alt="Discord Logo" style="width: 100px; margin-bottom: 1rem;">
    <p style="margin-top: 1rem;"><a href="https://discord.gg/uH3Vf8ed3B" target="_blank" style="color: #4FC3F7; text-decoration: underline;">Join via discord.gg/RivalRP</a></p>
  </section>
</body>
</html>
